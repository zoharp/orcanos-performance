# Orcanos Performance Testing Tool — Environment Variables

# === Backend ===

# Admin user password (used at first startup to seed the admin account)
ADMIN_PASSWORD=change-me

# Regular user password (used at first startup to seed the 'user' account)
USER_PASSWORD=change-me

# JWT signing secret — must be separate from ADMIN_PASSWORD
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-64-char-hex-key

# Google OAuth Client ID for Sign in with Google
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Encryption key for storing account passwords (32-char hex string)
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=change-me-32-char-hex-key

# FastAPI environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS configuration (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# Database (SQLite for local development)
DATABASE_URL=sqlite:///./orcanos_performance.db

# === Frontend (.env.local) ===

# Backend API URL
VITE_API_URL=http://localhost:8000

# Google OAuth Client ID for frontend Sign in with Google
# Must match GOOGLE_CLIENT_ID in backend
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# App configuration
VITE_APP_NAME=Orcanos Performance Tool
VITE_SESSION_TIMEOUT_MINUTES=60
